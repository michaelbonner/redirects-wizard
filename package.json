{
    "private": true,
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "prepare": "lefthook install",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start": "bun db:migrate && bun ./build/index.js",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
        "cli": "bun scripts/redirects.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:copy-production-to-preview": "bun scripts/copy-production-db-to-preview.ts",
        "db:copy-production-to-local": "bun scripts/copy-production-db-to-local.ts",
        "format": "vp fmt --write",
        "lint": "vp fmt --check && vp lint"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.12",
        "@tailwindcss/vite": "^4.3.3",
        "better-auth": "^1.7.12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.4",
        "lucide-svelte": "^1.0.1",
        "playwright": "^1.64.1",
        "postgres": "^3.4.9",
        "svelte": "^5.57.2",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@internationalized/date": "^3.12.4",
        "@lucide/svelte": "^1.60.0",
        "@sveltejs/adapter-bun": "^1.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^26.6.5",
        "@typescript/native": "npm:typescript@7",
        "bits-ui": "^2.20.0",
        "drizzle-kit": "^0.31.11",
        "lefthook": "^2.2.2",
        "shadcn-svelte": "^1.7.0",
        "svelte-check": "^4.7.7",
        "tailwind-variants": "^3.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "typescript-classic": "npm:typescript@6.0.3",
        "vite": "^8.3.4"
    },
    "patchedDependencies": {
        "svelte-check@4.7.7": "patches/svelte-check@4.7.7.patch",
        "@sveltejs/kit@3.1.0": "patches/@sveltejs%2Fkit@3.1.0.patch"
    }
}
