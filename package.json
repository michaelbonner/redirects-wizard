{
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "lefthook install",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "start": "bun db:migrate && bun ./build/index.js",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "cli": "bun scripts/redirects.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:copy-production-to-preview": "bun scripts/copy-production-db-to-preview.ts",
        "db:copy-production-to-local": "bun scripts/copy-production-db-to-local.ts",
        "format": "vp fmt --write",
        "lint": "vp fmt --check && vp lint"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.2",
        "@tailwindcss/vite": "^4.3.3",
        "better-auth": "^1.7.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.2",
        "lucide-svelte": "^1.0.1",
        "playwright": "^1.62.1",
        "postgres": "^3.4.9",
        "svelte": "^5.56.10",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@internationalized/date": "^3.12.3",
        "@lucide/svelte": "^1.34.0",
        "@sveltejs/kit": "^2.70.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^26.4.0",
        "bits-ui": "^2.19.0",
        "drizzle-kit": "^0.31.10",
        "lefthook": "^2.1.10",
        "shadcn-svelte": "^1.5.1",
        "svelte-adapter-bun": "^1.0.1",
        "svelte-check": "^4.7.6",
        "tailwind-variants": "^3.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    }
}
